{
  "expo": {
    "name": "Phaseo",
    "slug": "phaseo",
    "scheme": "phaseo",
    "version": "0.1.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.phaseo.client"
    },
    "android": {
      "package": "app.phaseo.client",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "general"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "phaseoOrigin": "https://phaseo.app",
      "phaseoApiOrigin": "https://api.phaseo.app/v1"
    }
  }
}
