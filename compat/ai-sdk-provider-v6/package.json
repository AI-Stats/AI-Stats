{
  "name": "@phaseo/ai-sdk-provider",
  "version": "1.0.2",
  "description": "Phaseo Gateway provider for Vercel AI SDK 6",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
