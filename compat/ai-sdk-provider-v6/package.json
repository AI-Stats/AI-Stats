    "@types/node": "22.19.3",
    "ai": "6.0.272",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "ai": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/phaseoteam/Phaseo",
    "directory": "compat/ai-sdk-provider-v6"
