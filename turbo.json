{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": { "cache": false, "persistent": true },
		"build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "dist/**", "build/**", ".mint/**"]
		},
		"@phaseo/web#build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**", "dist/**", "build/**", ".mint/**"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"packages/data/catalog/src/data/**",
				"apps/api/openapi.openai.yml",
				"apps/api/openapi.anthropic.json"
			]
		},
		"lint": { "outputs": [] },
		"typecheck": { "outputs": [] },
		"clean": { "cache": false }
	},
	"globalEnv": [
		"NEXT_PUBLIC_WEBSITE_URL",
		"NEXT_PUBLIC_STAGING_GATEWAY_BASE_URL",
		"STAGING_GATEWAY_BASE_URL",
		"EXPO_PUBLIC_PHASEO_ORIGIN",
		"EXPO_PUBLIC_PHASEO_API_ORIGIN",
		"WEB_API_ORIGIN",
		"CUTOVER_WRITE_FREEZE",
		"DATABASE_URL",
		"PLANETSCALE_DATABASE_URL",
		"PLANETSCALE_USE_PGBOUNCER",
		"PLANETSCALE_POOL_MAX",
		"PLANETSCALE_CONNECTION_TIMEOUT_MS",
		"PLANETSCALE_IDLE_TIMEOUT_MS",
		"BETTER_AUTH_ALLOW_SIGN_UP",
		"BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION",
		"BETTER_AUTH_SECRET",
		"BETTER_AUTH_URL",
		"BETTER_AUTH_TRUSTED_ORIGINS",
		"BETTER_AUTH_GOOGLE_CLIENT_ID",
		"BETTER_AUTH_GOOGLE_CLIENT_SECRET",
		"BETTER_AUTH_GITHUB_CLIENT_ID",
		"BETTER_AUTH_GITHUB_CLIENT_SECRET",
		"BETTER_AUTH_GITLAB_CLIENT_ID",
		"BETTER_AUTH_GITLAB_CLIENT_SECRET",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"GITHUB_CLIENT_ID",
		"GITHUB_CLIENT_SECRET",
		"GITLAB_CLIENT_ID",
		"GITLAB_CLIENT_SECRET",
		"UPSTASH_REDIS_REST_URL",
		"UPSTASH_REDIS_REST_TOKEN",
		"STRIPE_SECRET_KEY",
		"STRIPE_WEBHOOK_SECRET",
		"TEST_STRIPE_SECRET_KEY",
		"STRIPE_TEST_WEBHOOK_SECRET",
		"DISCORD_SIGNUP_WEBHOOK_URL",
		"DISCORD_BILLING_WEBHOOK_URL",
		"INVITE_ENCRYPTION_KEY",
		"HMAC_ENCRYPTION_KEY",
		"HMAC_ENCRPYTION_KEY",
		"WEBSITE_URL",
		"ADMIN_TOKEN",
		"YT_CALLBACK_URL",
		"YT_WEBHOOK_SECRET"
	]
}
